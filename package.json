{
  "name": "premium",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "bun": ">=1.2.0" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "factory": "bun run --cwd apps/factory src/main.ts",
    "db:generate": "bun run --cwd packages/db drizzle-kit generate",
    "db:migrate": "bun run --cwd packages/db src/migrate.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  }
}
