# Factory hot wallet. VPS only, 600 perms, funded with epoch budget only.
FACTORY_KEYPAIR_PATH=/etc/premium/factory-keypair.json

# ---- Turso ----
TURSO_DATABASE_URL=libsql://xxx.turso.io
TURSO_AUTH_TOKEN=

# ---- Watchdog ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
